<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Income shortfall calculator</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#17352f;background:#f2f5f1;font-synthesis:none}*{box-sizing:border-box}body{margin:0}main{max-width:1080px;margin:50px auto;padding:0 24px}header{margin-bottom:30px}.eyebrow{font-size:12px;font-weight:750;letter-spacing:2px;color:#537267}h1{font-size:clamp(30px,5vw,46px);letter-spacing:-1.6px;margin:10px 0}p{line-height:1.6;color:#61736b}.layout{display:grid;grid-template-columns:340px 1fr;gap:22px}.panel{background:white;border:1px solid #dce5dd;border-radius:20px;padding:28px}h2{font-size:19px;margin:0 0 22px}.field{margin:24px 0}label{display:block;font-size:14px;font-weight:650;margin-bottom:10px}.input{display:flex;align-items:center;background:#f7f9f6;border:1px solid #cddbd0;border-radius:10px;padding:0 14px;gap:6px}input[type=number]{background:transparent;border:0;width:100%;font:650 23px system-ui;color:#17352f;padding:12px 0;outline:none}.input:focus-within{outline:2px solid #278267}input[type=range]{width:100%;accent-color:#23775d;margin:15px 0 3px;cursor:pointer}.ends{display:flex;justify-content:space-between;font-size:11px;color:#718178}.badge{display:inline-block;border-radius:30px;background:#e9f4ed;padding:7px 12px;color:#286548;font-size:13px;font-weight:650}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0}.metric{border:1px solid #dce5dd;border-radius:14px;padding:20px}.metric small{display:block;color:#61736b;line-height:1.5}.amount{font-size:30px;letter-spacing:-1px;font-weight:750;margin:10px 0 3px}.detail{font-size:13px;line-height:1.6;color:#61736b}button{background:#fff;border:1px solid #ccd9ce;border-radius:8px;color:#315e4b;padding:9px 14px;cursor:pointer}.foot{font-size:12px;line-height:1.7;margin-top:22px}details{border-top:1px solid #dce5dd;padding-top:18px;margin-top:22px;font-size:13px;color:#61736b}summary{cursor:pointer;font-weight:650;color:#315e4b}#error{color:#9d3428;font-size:13px}output{display:block} @media(max-width:760px){main{margin:28px auto}.layout{grid-template-columns:1fr}.metrics{grid-template-columns:1fr}.panel{padding:22px}.amount{font-size:29px}}@media print{input[type=range],button{display:none}main{margin:0}.layout{grid-template-columns:300px 1fr}}
.annual{font-size:23px;font-weight:700;margin:18px 0 3px}.required{color:#b42318}</style></head><body><main><header><div class="eyebrow">MORTGAGE SCENARIO TOOL</div><h1>Income shortfall calculator</h1><p>Calculate any shortfall that must be mitigated.</p></header><div class="layout"><section class="panel"><h2>Application inputs</h2>
<div class="field"><label for="current">Current TDS</label><div class="input"><input id="current" type="number" min="0" max="200" step="0.01" value="48"><span>%</span></div><input id="currentRange" aria-label="Current TDS slider" type="range" min="0" max="100" step="0.1" value="48"><div class="ends"><span>0%</span><span id="currentMax">100%</span></div></div>
<div class="field"><label for="target">Target TDS</label><div class="input"><input id="target" type="number" min="0.01" max="200" step="0.01" value="44"><span>%</span></div><input id="targetRange" aria-label="Target TDS slider" type="range" min="0.1" max="100" step="0.1" value="44"><div class="ends"><span>0.1%</span><span id="targetMax">100%</span></div></div>
<div class="field"><label for="income">Total gross monthly income</label><div class="input"><span>$</span><input id="income" type="number" min="0.01" max="10000000" step="0.01" value="8000"></div><input id="incomeRange" aria-label="Monthly income slider" type="range" min="100" max="30000" step="50" value="8000"><div class="ends"><span>$100</span><span id="incomeMax">$30,000</span></div></div><p id="error" role="alert"></p><button id="reset" type="button">Reset example</button></section>
<section class="panel"><div id="results" aria-live="polite"><div class="metrics"><article class="metric"><small id="incomeLabel"></small><output class="amount" id="incomeDelta"></output><small>per month · gross income</small><output class="annual" id="incomeAnnual"></output><small>per year · gross income</small><p class="detail" id="incomeDetail"></p></article><article class="metric"><small id="debtLabel"></small><output class="amount" id="debtDelta"></output><small>per month · debt-service payments</small><output class="annual" id="debtAnnual"></output><small>per year · debt-service payments</small><p class="detail" id="debtDetail"></p></article></div>
</div></section></div></main>
<script>
const $=id=>document.getElementById(id);const money=n=>new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD',minimumFractionDigits:2,maximumFractionDigits:2}).format(Math.abs(n));
function calculate(c,t,i){const d=c/100*i,r=t/100,g=d-r*i;const di=g/r,dd=g;return {d,r,g,di,dd}}
function render(){const c=Number($('current').value),t=Number($('target').value),i=Number($('income').value);const valid=['current','target','income'].every(id=>$(id).value!==''&&$(id).validity.valid)&&Number.isFinite(c+t+i)&&t>0&&i>0;
$('error').textContent=valid?'':'Enter a valid TDS (0–200%), target (above 0–200%), and positive monthly income (up to $10 million).';$('results').hidden=!valid;if(!valid)return;
const a=calculate(c,t,i),over=a.g>1e-8,under=a.g< -1e-8;const set=(id,text)=>$(id).textContent=text;for(const id of ['incomeDelta','debtDelta','incomeAnnual','debtAnnual'])$(id).classList.toggle('required',over);
set('incomeLabel',over?'Additional income required':under?'Income surplus':'Income adjustment');set('debtLabel',over?'Monthly payment reduction required':under?'Monthly payment increase available':'Monthly payment adjustment');set('incomeDelta',money(a.di));set('debtDelta',money(a.dd));set('incomeAnnual',money(a.di*12));set('debtAnnual',money(a.dd*12));set('incomeDetail','Income needed at current payments: '+money(a.d/a.r)+'/month.');set('debtDetail','Payments allowed at current income: '+money(i*a.r)+'/month.');}

for(const id of ['current','target','income']){const n=$(id),r=$(id+'Range');n.addEventListener('input',()=>{if(n.value!==''&&n.validity.valid){r.max=Math.max(id==='income'?30000:100,Number(n.value));r.min=id==='income'?Math.min(100,Number(n.value)):id==='target'?Math.min(.1,Number(n.value)):0;r.value=n.value;$(id+'Max').textContent=id==='income'?'$'+Number(r.max).toLocaleString('en-CA'):r.max+'%'}render()});r.addEventListener('input',()=>{n.value=r.value;render()})}
$('reset').addEventListener('click',()=>{for(const [id,v] of Object.entries({current:48,target:44,income:8000})){ $(id).value=v;$(id).dispatchEvent(new Event('input'))}render()});render();
</script></body></html>
